# Header di sicurezza per RSSIntel.
#
# Le direttive `Header` NON possono stare in .htaccess senza `AllowOverride
# FileInfo` (e se AllowOverride cambia, Apache va in 500). Vanno quindi nel
# vhost / nella config del server, dentro il blocco <Directory> o <VirtualHost>
# che serve RSSIntel. Richiede mod_headers (a2enmod headers).
#
#   <Directory /var/www/html/rssintel>
#       ... (AllowOverride, Require, ecc.)
#       Include /etc/apache2/conf-available/rssintel-security-headers.conf
#   </Directory>
#
# oppure incolla direttamente queste righe nel blocco:

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
    # CSP moderata: blocca risorse esterne, framing, plugin ed esfiltrazione via
    # form. 'unsafe-inline' e' necessario perche' il portale usa <script>,
    # handler onclick/onsubmit e attributi style= inline.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"

    # Cache lunga per gli asset statici versionati (?v=...); l'HTML resta no-cache.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
