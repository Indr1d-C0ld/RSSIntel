[Unit]
Description=RSSIntel - catture visive in coda (avviate su richiesta)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
ExecStart=/usr/bin/python3 /opt/rssintel/rssintel_capture.py
WorkingDirectory=/opt/rssintel
Environment=HOME=/tmp RSSINTEL_DB=/var/lib/rssintel/rssintel.db PYTHONDONTWRITEBYTECODE=1
Nice=10
IOSchedulingClass=idle
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/rssintel
ProtectHome=yes
LimitNOFILE=8192
TimeoutStartSec=900
MemoryMax=1536M
