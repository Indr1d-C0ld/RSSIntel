[Unit]
Description=RSSIntel - raccolta e indicizzazione dei feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
Environment=RSSINTEL_DB=/var/lib/rssintel/rssintel.db PYTHONDONTWRITEBYTECODE=1
Environment="RSSINTEL_UA=RSSIntel/1.1 (+https://example.org; research)"
ExecStart=/opt/rssintel-venv/bin/python /opt/rssintel/rssintel_fetch.py
ExecStartPost=-/opt/rssintel-venv/bin/python /opt/rssintel/rssintel_watch.py
WorkingDirectory=/opt/rssintel
# priorita' minima di CPU e disco: mai un picco che si senta
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
TimeoutStartSec=30min
UMask=0002
ProtectSystem=strict
ReadWritePaths=/var/lib/rssintel
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
